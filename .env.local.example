DATABASE_URL=postgresql://user:password@localhost:5432/rag_training
# Embeddings: local oMLX server (OpenAI-compatible) serving BAAI/bge-m3
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=sk-omlx-your-key-here
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# Chat: same oMLX server and key (override with CHAT_BASE_URL / CHAT_API_KEY if needed)
CHAT_MODEL=Qwen3-4B-Instruct-2507-4bit

# Folder of the AI training HTML decks (the RAG knowledge base), indexed by `bun ingest`
DECKS_DIR=/path/to/oman-lng-ai-acceleration-training/decks/html/ai-intro-integ
